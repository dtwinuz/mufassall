---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "../styles/tokens.css";
import "../styles/site.css";
import { LANGS, type Lang } from "@mufassall/content";
import { site } from "../i18n/site";
import { test } from "../i18n/learner";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** share card path, e.g. /og/uz/caching.png; defaults to the language card /og/<lang>.png */
  image?: string;
  /** JSON-LD object(s), rendered as application/ld+json (not executed, so outside the script CSP) */
  jsonLd?: object | object[];
  /** error page: no canonical/hreflang, noindex, language links go to each home page */
  notFound?: boolean;
  active?: "learn" | "lab" | "glossary" | "review" | "test" | "tools" | "paths";
}

const { lang, title, description, active = "learn" } = Astro.props;
const s = site[lang];
const pageTitle = title ? `${title} · mufassall` : `mufassall · ${s.tagline}`;
const desc = description ?? s.description;
const { image, jsonLd, notFound = false } = Astro.props;
const rest = notFound ? "/" : Astro.url.pathname.replace(/^\/(uz|ru|en)(?=\/)/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const OG_LOCALE: Record<Lang, string> = { uz: "uz_UZ", ru: "ru_RU", en: "en_US" };
const ogImage = new URL(image ?? `/og/${lang}.png`, Astro.site).href;
const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {notFound && <meta name="robots" content="noindex" />}
    {!notFound && <link rel="canonical" href={canonical.href} />}
    {!notFound && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}${rest}`, Astro.site).href} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={new URL(`/uz${rest}`, Astro.site).href} />}
    <meta property="og:site_name" content="mufassall" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={image ? "article" : "website"} />
    {!notFound && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? s.tagline} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="brand" href={`/${lang}/`} aria-label="mufassall">
          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
            <path d="M16 3 27 9.5v13L16 29 5 22.5v-13Z" class="brand__ink" />
            <path d="M16 16 27 9.5M16 16v13M16 16 5 9.5" class="brand__axis" />
            <circle cx="16" cy="16" r="2.6" class="brand__node" />
          </svg>
          <span>mufassall</span>
        </a>
        <nav class="site-nav" aria-label="main">
          <a href={`/${lang}/`} aria-current={active === "learn" ? "page" : undefined}>{s.nav.learn}</a>
          <a href={`/${lang}/lab/`} aria-current={active === "lab" ? "page" : undefined}>{s.nav.lab}</a>
          <a href={`/${lang}/glossary/`} aria-current={active === "glossary" ? "page" : undefined}>{s.nav.glossary}</a>
          <a href={`/${lang}/review/`} aria-current={active === "review" ? "page" : undefined}>{s.nav.review}<span class="nav-badge" data-review-badge></span></a>
          <a href={`/${lang}/test/`} aria-current={active === "test" ? "page" : undefined}>{test[lang].nav}</a>
          <a href={`/${lang}/paths/`} aria-current={active === "paths" ? "page" : undefined}>{s.learner.nav.paths}</a>
          <a href={`/${lang}/tools/`} aria-current={active === "tools" ? "page" : undefined}>{s.learner.nav.tools}</a>
        </nav>
        <div class="site-tools">
          <button type="button" class="search-btn" data-search-open aria-label={s.search.label} aria-keyshortcuts="Control+K Meta+K /">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
            <span class="search-btn__text">{s.search.open}</span>
            <kbd>Ctrl K</kbd>
          </button>
          <nav class="langs" aria-label="language">
            {
              LANGS.map((l) => (
                <a href={`/${l}${rest}`} lang={l} aria-current={l === lang ? "true" : undefined} title={site[l].langName}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </nav>
          <button type="button" class="theme-btn" data-theme-toggle aria-label={s.theme} title={s.theme}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-foot wrap">{s.footer}</footer>
    <dialog class="search" data-search aria-label={s.search.label} data-hint={s.search.hint} data-empty={s.search.empty} data-lesson={s.search.lesson} data-step={s.search.step} data-term={s.search.term}>
      <div class="search__box">
        <input name="q" type="search" role="combobox" aria-expanded="true" aria-controls="search-list" aria-autocomplete="list" placeholder={s.search.placeholder} aria-label={s.search.label} autocomplete="off" spellcheck="false" />
        <ul id="search-list" role="listbox" class="search__list"></ul>
      </div>
    </dialog>
    <script is:inline src="/search.js" defer></script>
    <script is:inline src="/pwa.js" defer></script>
    <script is:inline src="/activity.js" defer></script>
  </body>
</html>
