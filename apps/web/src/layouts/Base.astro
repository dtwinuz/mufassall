---
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "../styles/tokens.css";
import "../styles/site.css";
import { LANGS, type Lang } from "@mufassall/content";
import { site } from "../i18n/site";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  active?: "learn" | "lab";
}

const { lang, title, description, active = "learn" } = Astro.props;
const s = site[lang];
const pageTitle = title ? `${title} · mufassall` : `mufassall · ${s.tagline}`;
const desc = description ?? s.description;
const rest = Astro.url.pathname.replace(/^\/(uz|ru|en)(?=\/)/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}${rest}`, Astro.site).href} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="brand" href={`/${lang}/`} aria-label="mufassall">
          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
            <path d="M16 3 27 9.5v13L16 29 5 22.5v-13Z" class="brand__ink" />
            <path d="M16 16 27 9.5M16 16v13M16 16 5 9.5" class="brand__axis" />
            <circle cx="16" cy="16" r="2.6" class="brand__node" />
          </svg>
          <span>mufassall</span>
        </a>
        <nav class="site-nav" aria-label="main">
          <a href={`/${lang}/`} aria-current={active === "learn" ? "page" : undefined}>{s.nav.learn}</a>
          <a href={`/${lang}/lab/`} aria-current={active === "lab" ? "page" : undefined}>{s.nav.lab}</a>
          <span class="site-nav__soon">{s.nav.practice} <small>{s.nav.soon}</small></span>
        </nav>
        <div class="site-tools">
          <nav class="langs" aria-label="language">
            {
              LANGS.map((l) => (
                <a href={`/${l}${rest}`} lang={l} aria-current={l === lang ? "true" : undefined} title={site[l].langName}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </nav>
          <button type="button" class="theme-btn" data-theme-toggle aria-label={s.theme} title={s.theme}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-foot wrap">{s.footer}</footer>
  </body>
</html>
