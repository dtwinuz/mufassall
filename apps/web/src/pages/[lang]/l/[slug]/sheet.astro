---
import { LANGS, type Lang, lessons, sectionOf } from "@mufassall/content";
import { Scene, designState, hasExchanges, lessonBounds, toD2, toMermaidFlowchart, toMermaidSequence } from "@mufassall/scene-engine";
import { resolve } from "@mufassall/scene-schema";
import "@mufassall/scene-engine/player.css";
import Base from "../../../../layouts/Base.astro";
import { diagram } from "../../../../i18n/learner";
import { site } from "../../../../i18n/site";
import { rich, sheetOf } from "../../../../lib/learner";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => Object.keys(lessons).map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const s = site[lang];
const L = s.learner.sheet;
const entry = lessons[slug]!;
const text = entry.text[lang];
const sheet = sheetOf(slug, lang);
const states = resolve(entry.lesson);
const last = states[states.length - 1]!;
const section = sectionOf(slug);
const where = section ? s.sections[section.id]?.title : undefined;
const href = `/${lang}/l/${slug}/`;

// "Diagram as code": generated here at build time, sheet.js only switches tabs and copies
const D = diagram[lang];
const design = designState(entry.lesson);
const nodeLabels = text.nodes as Record<string, string>;
const codes = [
  { id: "flow", name: D.flow, syntax: "mermaid", code: toMermaidFlowchart(design, nodeLabels, { words: D.words }) },
  ...(hasExchanges(entry.lesson) ? [{ id: "seq", name: D.seq, syntax: "mermaid", code: toMermaidSequence(entry.lesson, text) }] : []),
  { id: "d2", name: D.d2, syntax: "d2", code: toD2(design, nodeLabels, { words: D.words }) },
].map((c) => ({ ...c, code: c.code.trimEnd() }));
---

<Base lang={lang} title={`${sheet.title} · ${L.title}`} description={sheet.summary}>
  <article class="sheet" data-sheet={slug}>
    <header class="sheet__head">
      <p class="sheet__kicker">{L.title}{where && ` · ${where}`}</p>
      <h1 data-part="title">{sheet.title}</h1>
      <p class="sheet__meta">
        {s.home.minutesN.replace("{n}", String(sheet.minutes))} · {sheet.level} · mufassall.dtwin.uz{href}
      </p>
      <div class="sheet__actions">
        <a class="mf-btn" href={href}>← {L.open}</a>
        <button type="button" class="mf-btn mf-btn--primary" data-print hidden>{L.print}</button>
      </div>
    </header>

    <div class="sheet__grid">
      <section class="sheet__block" data-part="summary">
        <h2>{L.problem}</h2>
        <p>{sheet.summary}</p>
      </section>
      <section class="sheet__block" data-part="learn">
        <h2>{L.learn}</h2>
        <ul>{sheet.learn.map((l) => <li set:html={rich(l)} />)}</ul>
      </section>
    </div>

    <figure class="sheet__scene" data-part="scene">
      <figcaption>{L.scene}</figcaption>
      <div class="sheet__stage">
        <Scene state={{ ...last, focus: [] }} box={lessonBounds(states)} labels={text.nodes as Record<string, string>} title={text.title} paused reduced runKey={0} />
      </div>
    </figure>

    <section class="sheet__block sheet__code" data-part="code" data-code-tabs data-copied={D.copied} data-failed={D.failed} aria-labelledby="code-title">
      <h2 id="code-title">{D.title}</h2>
      <p class="sheet__code-lead">{D.lead}</p>
      <div class="sheet__tabs" role="tablist" aria-label={D.tabs} hidden>
        {
          codes.map((c, i) => (
            <button type="button" role="tab" id={`code-tab-${c.id}`} aria-controls={`code-${c.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              {c.name}
            </button>
          ))
        }
      </div>
      {
        codes.map((c) => (
          <div class="sheet__panel" role="tabpanel" id={`code-${c.id}`} aria-labelledby={`code-tab-${c.id}`} tabindex="0">
            <h3 class="sheet__panel-name" data-panel-name>{c.name}</h3>
            <pre><code class={`language-${c.syntax}`} data-code>{c.code}</code></pre>
            <button type="button" class="mf-btn" data-copy hidden>{D.copy}</button>
          </div>
        ))
      }
      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
    </section>

    {
      sheet.recap.length > 0 && (
        <section class="sheet__block sheet__recap" data-part="recap">
          <h2>{L.recap}</h2>
          {sheet.recap.map((p) => (
            <p set:html={rich(p)} />
          ))}
        </section>
      )
    }

    {
      sheet.metrics.length > 0 && (
        <section class="sheet__block" data-part="metrics">
          <h2>{L.metrics}</h2>
          <table class="sheet__table">
            <thead>
              <tr>
                <th scope="col">{L.metric}</th>
                <th scope="col">{L.before}</th>
                <th scope="col">{L.after}</th>
              </tr>
            </thead>
            <tbody>
              {sheet.metrics.map((m) => (
                <tr>
                  <th scope="row">{m.label}</th>
                  <td>{m.before}</td>
                  <td class={`sheet__trend--${m.trend}`}>
                    {m.after} <span aria-hidden="true">{m.trend === "better" ? "✓" : m.trend === "worse" ? "!" : ""}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    <section class="sheet__block" data-part="steps">
      <h2>{L.steps}</h2>
      <ol class="sheet__steps">
        {
          sheet.steps.map((st) => (
            <li>
              <a href={`${href}?step=${st.n}`}>
                <span class="sheet__kind">{st.kind}</span> <strong set:html={rich(st.title)} />
              </a>
              {st.line && <p set:html={rich(st.line)} />}
            </li>
          ))
        }
      </ol>
    </section>

    {
      sheet.terms.length > 0 && (
        <section class="sheet__block" data-part="terms">
          <h2>{L.terms}</h2>
          <dl class="sheet__terms">
            {sheet.terms.map((g) => (
              <div>
                <dt>
                  <a href={`/${lang}/glossary/#${g.id}`}>{g.name}</a>
                </dt>
                <dd>{g.short}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>
  <script is:inline src="/sheet.js" defer></script>
</Base>

<style>
  .sheet__code-lead {
    color: var(--muted);
  }
  .sheet__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 12px 0 0;
    border-bottom: 1px solid var(--line);
  }
  .sheet__tabs [role="tab"] {
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .sheet__tabs [role="tab"][aria-selected="true"] {
    border-bottom-color: var(--signal);
    color: var(--fg);
    font-weight: 600;
  }
  .sheet__tabs [role="tab"]:focus-visible,
  .sheet__panel:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
  .sheet__panel {
    margin-top: 12px;
  }
  .sheet__panel-name {
    margin: 16px 0 6px;
    font-size: 1rem;
  }
  .sheet__panel pre {
    max-height: 26rem;
    margin: 0 0 8px;
    padding: 12px 14px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 6px);
    background: var(--code);
    font: 0.85rem/1.5 var(--font-mono);
    tab-size: 2;
  }
  /* code on paper cannot be pasted, and the scene picture above already shows the design */
  @media print {
    .sheet__code {
      display: none;
    }
  }
</style>
