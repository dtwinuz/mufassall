---
import { LANGS, type Lang, lessons, order, sections } from "@mufassall/content";
import { Scene, SceneDefs, lessonBounds } from "@mufassall/scene-engine";
import { resolve } from "@mufassall/scene-schema";
import "@mufassall/scene-engine/player.css";
import Base from "../../layouts/Base.astro";
import { player } from "../../i18n/ui";
import { site } from "../../i18n/site";
import { courseLd } from "../../og/ld";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = site[lang];
const ui = player[lang];
const L = s.learner;
const first = order[0];
const minutesOf = (slugs: string[]) => slugs.reduce((sum, sl) => sum + lessons[sl]!.lesson.minutes, 0);
---

<Base lang={lang} jsonLd={courseLd(lang)}>
  <svg class="scene-defs" aria-hidden="true" focusable="false"><SceneDefs /></svg>
  <section class="home-hero">
    <h1>{s.home.title}</h1>
    <p>{s.home.lead}</p>
    <div class="home-hero__actions">
      {first && <a class="mf-btn mf-btn--primary" href={`/${lang}/l/${first}/`}>{s.home.startCourse} →</a>}
      <a class="mf-btn" href={`/${lang}/lab/`}>{s.home.openLab}</a>
      <button type="button" class="mf-btn" data-offline hidden data-busy={s.home.offline.busy} data-done={s.home.offline.done} data-fail={s.home.offline.fail}>
        {s.home.offline.save}
      </button>
    </div>
    <p class="home-hero__status" data-offline-status role="status"></p>
  </section>

  <section
    class="rhythm"
    aria-labelledby="rhythm"
    data-streak
    data-days-n={L.streak.daysN}
    data-active={L.streak.active}
    data-idle={L.streak.idle}
    data-today={L.streak.today}
    data-reached={L.streak.reached}
  >
    <div class="rhythm__main">
      <h2 id="rhythm">{L.streak.title}</h2>
      <dl class="rhythm__stats">
        <div>
          <dt>{L.streak.current}</dt>
          <dd data-streak-current>–</dd>
        </div>
        <div>
          <dt>{L.streak.best}</dt>
          <dd data-streak-best>–</dd>
        </div>
      </dl>
      <div class="rhythm__goal">
        <label for="rhythm-goal">{L.streak.goal}</label>
        <select id="rhythm-goal" data-streak-goal>
          {Object.entries(L.streak.goals).map(([id, label]) => <option value={id}>{label}</option>)}
        </select>
        <progress data-streak-bar max="5" value="0" aria-labelledby="rhythm-today"></progress>
        <p id="rhythm-today" data-streak-today>{L.streak.today.replace("{n}", "0").replace("{goal}", "5")}</p>
      </div>
      <a class="rhythm__paths" href={`/${lang}/paths/`}>{L.streak.paths} →</a>
      <div class="rhythm__cert" data-share-course hidden>
        <p>{L.share.courseText}</p>
        <button type="button" class="mf-btn mf-btn--primary" data-share="course" data-course data-title={s.tagline} data-count={order.length}>
          {L.share.course}
        </button>
      </div>
    </div>
    <div class="heat" data-heat role="group" aria-label={L.streak.heat}>
      {Array.from({ length: 84 }, () => <span class="heat__cell" data-cell></span>)}
    </div>
  </section>

  <section class="course-map" aria-labelledby="course-map">
    <div class="track__head">
      <h2 id="course-map">{s.home.map}</h2>
      <p>{s.home.mapLead}</p>
    </div>
    <ol class="course-map__list">
      {
        sections.map((sec, i) => (
          <li>
            <a href={`#s-${sec.id}`}>
              <span class="course-map__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="course-map__title">{s.sections[sec.id]?.title}</span>
              <span class="course-map__meta">
                {s.home.lessonsN.replace("{n}", String(sec.lessons.length))} · {s.home.minutesN.replace("{n}", String(minutesOf(sec.lessons)))}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    sections.map((sec, i) => (
      <section class="track" id={`s-${sec.id}`} aria-labelledby={`track-${sec.id}`}>
        <div class="track__head">
          <p class="track__n">{String(i + 1).padStart(2, "0")}</p>
          <h2 id={`track-${sec.id}`}>{s.sections[sec.id]?.title}</h2>
          <p>{s.sections[sec.id]?.text}</p>
          <button type="button" class="mf-btn track__share" data-share={sec.id} data-title={s.sections[sec.id]?.title} data-count={sec.lessons.length} hidden>
            ✓ {L.share.sectionDone} · {L.share.button}
          </button>
        </div>
        <ul class="lessons">
          {sec.lessons.map((slug) => {
            const entry = lessons[slug]!;
            const text = entry.text[lang];
            const states = resolve(entry.lesson);
            const last = states[states.length - 1]!;
            return (
              <li>
                <a class="lesson-card" href={`/${lang}/l/${slug}/`} data-progress={slug} data-steps={states.length}>
                  <div class="lesson-card__preview" aria-hidden="true">
                    <Scene
                      state={{ ...last, focus: [] }}
                      box={lessonBounds(states)}
                      labels={text.nodes as Record<string, string>}
                      title={text.title}
                      paused
                      reduced
                      runKey={0}
                      defs={false}
                    />
                  </div>
                  <h3>{text.title}</h3>
                  <p>{text.summary}</p>
                  <div class="lesson-card__meta">
                    <span>
                      {ui.minutes.replace("{n}", String(entry.lesson.minutes))} · {ui.steps.replace("{n}", String(states.length))} ·{" "}
                      {ui.levels[entry.lesson.level]}
                    </span>
                    <span class="lesson-card__cta" data-label-start={s.home.start} data-label-continue={s.home.continue} data-label-done={s.home.done}>
                      {s.home.start} →
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <section class="upcoming" aria-labelledby="upcoming">
    <h2 id="upcoming">{s.home.upcoming}</h2>
    <ul>
      {s.home.upcomingList.map((item) => <li>{item}</li>)}
    </ul>
  </section>
  <dialog
    class="share-dlg"
    data-share-dialog
    aria-labelledby="share-title"
    data-section-done={L.share.sectionDone}
    data-course-done={L.share.courseDone}
    data-lessons-n={L.share.lessonsN}
    data-text={L.share.text}
  >
    <form method="dialog" class="share-dlg__box">
      <h2 id="share-title">{L.share.title}</h2>
      <canvas class="share-dlg__canvas" width="1200" height="630" role="img" aria-label={L.share.preview}></canvas>
      <label class="share-dlg__name">
        <span>{L.share.name}</span>
        <input name="name" type="text" maxlength="48" autocomplete="off" aria-describedby="share-note" />
      </label>
      <p id="share-note" class="share-dlg__note">{L.share.nameNote}</p>
      <div class="share-dlg__actions">
        <button type="button" class="mf-btn mf-btn--primary" data-share-download>{L.share.download}</button>
        <button type="button" class="mf-btn" data-share-send hidden>{L.share.send}</button>
        <button type="submit" class="mf-btn" value="close">{L.share.close}</button>
      </div>
    </form>
  </dialog>
  <script is:inline src="/progress.js" defer></script>
  <script is:inline src="/share.js" defer></script>
</Base>
