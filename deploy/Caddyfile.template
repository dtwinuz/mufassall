{
	# Admin API only inside the container: deploy/receive.sh reloads config through it.
	admin localhost:2019
	auto_https off
	# The edge Caddy (same docker network) sets X-Forwarded-For; keep it so the API sees the client.
	servers {
		trusted_proxies static private_ranges
	}
}

# Generated by tools/postbuild.mjs from deploy/Caddyfile.template — edit the template.
:80 {
	# releases/current is a symlink swapped atomically by deploy/receive.sh.
	root * /srv/releases/current
	encode zstd gzip

	# /_astro/* names carry a content hash: cache forever. Everything else revalidates (ETag, 304).
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@rest not path /_astro/* /api/*
	header @rest Cache-Control "no-cache"

	header {
		# style attributes are rendered by the scene (SVG positions); scripts stay hash-only.
		Content-Security-Policy "default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Feedback, gallery, health: the mufassall-api container (apps/api/server.mjs).
	handle /api/* {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy mufassall-api:8080
	}

	handle {
		file_server
	}

	handle_errors 413 {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":"too_large"}` 413
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
